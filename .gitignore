# Per-experiment results directories (keep the folder, ignore contents)
experiments/*/results/*
!experiments/*/results/.gitkeep

# Local diffusers sweep outputs (Exp 01 / Exp 03 sweep_local.py).
# Ignore the bulk (generated PNGs, ~1.2 GB) but KEEP the derived artifacts:
# the report / judgement / quality / metadata JSON and the analysis figures.
# Those are the actual scientific record and total ~1.3 MB. Losing them would
# mean re-running paid API judging and ~11 h of compute to recover a result.
experiments/*/results-local/**
!experiments/*/results-local/*/
!experiments/*/results-local/*/*.json
!experiments/*/results-local/*/figures/
!experiments/*/results-local/*/figures/*.png

# Locally-downloaded model weights (never commit — multi-GB)
experiments/*/sdxl_local/

# Matplotlib cache from analyze.py
experiments/*/.mplcache/

# Top-level results
results/*
!results/.gitkeep

# Generated experiment outputs served by the book site
site/public/results/

# Exp 03 smoke-test scratch logs
experiments/03_l23_hardening/smoke_*.log
experiments/03_l23_hardening/dl_resume.log

# Exp 03 run logs (byproducts of gen/judge/quality/analyze — like results-local/)
experiments/03_l23_hardening/gen_*.log
experiments/03_l23_hardening/judge_*.log
experiments/03_l23_hardening/quality_*.log
experiments/03_l23_hardening/analyze_*.log
